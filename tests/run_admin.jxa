ObjC.import('Foundation');ObjC.import('JavaScriptCore');
function run(){
  const root=$.NSFileManager.defaultManager.currentDirectoryPath.js;
  function read(path){return $.NSString.stringWithContentsOfFileEncodingError(root+'/'+path,$.NSUTF8StringEncoding,null).js;}
  const context=$.JSContext.new;
  context.evaluateScript(read('tests/test_admin_ui.js')+'\nvar result,failure;runAdminTests('+JSON.stringify(read('backend/web/admin.js'))+').then(value=>{result=value;},error=>{failure=String(error.stack||error);});');
  if(!context.exception.isNil())throw new Error(ObjC.unwrap(context.exception.toObject));
  const failure=context.objectForKeyedSubscript('failure');if(!failure.isUndefined)throw new Error(ObjC.unwrap(failure.toObject));
  const result=context.objectForKeyedSubscript('result');if(result.isUndefined)throw new Error('Tests did not finish');
  return ObjC.unwrap(result.toObject);
}
